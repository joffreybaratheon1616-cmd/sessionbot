# Telegram Bot Token (from @BotFather)
BOT_TOKEN=123456:ABC-DEF...

# Telegram API credentials (from https://my.telegram.org)
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# MongoDB connection
MONGO_URI=mongodb://localhost:27017
DB_NAME=session_manager

# Comma-separated list of owner Telegram user IDs (leave empty for open mode)
OWNER_IDS=123456789,987654321

# Guard check interval in seconds (Telegram rate-limits GetAuthorizations; keep >= 5)
GUARD_INTERVAL=5

# Temporary "Allow Login" window duration in seconds
ALLOW_LOGIN_SECONDS=60

# IMAP timeout for mail features
IMAP_TIMEOUT_SECONDS=15

# Telethon MTProto connect+verify timeout
MTPROTO_TIMEOUT=30
